.board {
  width: fit-content;
  display: grid;
  background: grey;
  grid-template: repeat(5, 1fr) / repeat(4, 1fr);
  -webkit-user-drag: none;
  user-select: none;
}

.space {
  width: 100px;
  height: 100px;
  box-shadow: 0 0 2px #000000 inset;
  display: flex;
  align-items: center;
  justify-content: center;

}

.piece,
.blank {
  width: 95px;
  height: 95px;
  box-sizing: border-box;
  cursor: grab;
  user-select: none;
  -webkit-user-drag: none;
  -moz-user-select: none;
}

.blank {
  /* background: grey; */
  /* border: 1px solid black; */
  cursor: unset;

}



.smallSquare {
  background: #bebe07;
  display: flex;
  align-items: center;
  justify-content: center;
}

.smallSquare .inner {
  pointer-events: none;
  background: yellow;
  width: 80px;
  height: 80px;
}

.bigSquare {
  background: red;
}

.horizontalRect {
  background: blue;
  position: relative;
}

.horizontalRect.leftmost::after {
  content: "";
  pointer-events: none;
  position: absolute;
  width: 195px;
  height: 95px;
  left: 0;
  top: 0;
  background: purple;
  z-index: 4;
}

.horizontalRect.leftmost::before {
  content: "";
  pointer-events: none;
  position: absolute;
  width: 180px;
  height: 80px;
  left: 7.5px;
  top: 7.5px;
  background: cyan;
  z-index: 5;
}

.verticalRect {
  background: green;
}
